#!/bin/sh
set -eu

usage() {
  echo "usage: kogen-bench <task_dir> <work_dir> <out_dir>" >&2
  exit 2
}

[ "$#" -eq 3 ] || usage
recipe=${KOGEN_BENCH_RECIPE:-staged}
case "$recipe" in
  staged|direct|direct-shell) ;;
  *) echo "KOGEN_BENCH_RECIPE must be staged, direct, or direct-shell" >&2; exit 2 ;;
esac
task_dir=$(cd "$1" && pwd -P)
work_dir=$(cd "$2" && pwd -P)
mkdir -p "$3"
out_dir=$(cd "$3" && pwd -P)
task_json="$task_dir/task.json"
prompt_file="$task_dir/prompt.md"
log_file="$out_dir/log.txt"

[ -f "$task_json" ] || { echo "missing task.json" >&2; exit 2; }
[ -f "$prompt_file" ] || { echo "missing prompt.md" >&2; exit 2; }
[ -d "$work_dir/.git" ] || [ -f "$work_dir/.git" ] || {
  echo "work_dir must be a git checkout" >&2
  exit 2
}

KOGEN_BIN=${KOGEN_BIN:-$(command -v kogen || true)}
[ -n "$KOGEN_BIN" ] && [ -x "$KOGEN_BIN" ] || {
  echo "kogen executable not found; set KOGEN_BIN or add kogen to PATH" >&2
  exit 3
}

work_base=$(git -C "$work_dir" rev-parse HEAD)
work_status=$(git -C "$work_dir" status --porcelain --untracked-files=all)
[ -z "$work_status" ] || {
  echo "work_dir must be clean before the benchmark starts" >&2
  exit 2
}

bench_tmpdir=$(python3 - "$task_json" <<'PY'
import json
import os
import sys

with open(sys.argv[1], encoding="utf-8") as source:
    document = json.load(source)
env = document.get("env", {})
if isinstance(env, list):
    env = dict(entry.split("=", 1) for entry in env if isinstance(entry, str) and "=" in entry)
if not isinstance(env, dict):
    env = {}
print(os.path.abspath(env.get("TMPDIR") or os.environ.get("TMPDIR") or "/tmp"))
PY
)
mkdir -p "$bench_tmpdir"
scratch=$(mktemp -d "${bench_tmpdir%/}/kogen-bench.XXXXXX")
trap 'rm -rf "$scratch"' EXIT
project_dir="$scratch/project"
origin="$scratch/origin.git"
events_file="$out_dir/events.jsonl"
timings_file="$scratch/phase-events.jsonl"
phase_file="$scratch/phase"
timer_script="$scratch/bench_timer.py"
bench_started_ns=$(python3 -c 'import time; print(time.monotonic_ns())')
mkdir -p "$out_dir"
: > "$log_file"
: > "$out_dir/final.diff"
: > "$timings_file"
: > "$events_file"
printf 'shape\n' > "$phase_file"
cat > "$timer_script" <<'PY'
import json
import subprocess
import sys
import time

phase_path, event_path, name = sys.argv[1:4]
argv = sys.argv[5:]
if argv[:1] == ["--"]:
    argv = argv[1:]
if not argv:
    raise SystemExit("benchmark timer requires a command")

phase = open(phase_path, encoding="utf-8").read().strip()
started_at = time.time_ns() // 1_000_000
started = time.monotonic_ns()
status = subprocess.run(argv, check=False).returncode
wall_ms = max((time.monotonic_ns() - started) // 1_000_000, 0)
finished_at = time.time_ns() // 1_000_000
row = {
    "event": "phase_timing",
    "phase": phase,
    "name": name,
    "wall_ms": int(wall_ms),
    "started_at": int(started_at),
    "finished_at": int(finished_at),
}
with open(event_path, "a", encoding="utf-8") as target:
    target.write(json.dumps(row, separators=(",", ":")) + "\n")
raise SystemExit(status)
PY
cat > "$out_dir/usage.json" <<JSON
{
  "recipe": "$recipe",
  "status": "not_started",
  "stages": [],
  "total": {
    "tokens": {"input": 0, "cached_input": 0, "output": 0, "reasoning": 0},
    "wall_ms": 0
  }
}
JSON

git clone --quiet "$work_dir" "$project_dir"
git -C "$project_dir" checkout --quiet -B main "$work_base"
mkdir -p "$project_dir/.kogen"
python3 - "$task_json" "$project_dir/.kogen/project.yaml" "$scratch/project_tmpdir" \
  "$timer_script" "$phase_file" "$timings_file" <<'PY'
import json
import os
import re
import shutil
import sys

source_path, target_path, tmpdir_path, timer_path, phase_path, event_path = sys.argv[1:]
with open(source_path, encoding="utf-8") as source:
    document = json.load(source)

raw_env = document.get("env", {})
if isinstance(raw_env, dict):
    env = {str(key): str(value) for key, value in raw_env.items()}
elif isinstance(raw_env, list):
    env = {}
    for entry in raw_env:
        if isinstance(entry, str) and "=" in entry:
            key, value = entry.split("=", 1)
            env[key] = value
else:
    env = {}

if env.get("TMPDIR"):
    env["TMPDIR"] = os.path.abspath(env["TMPDIR"])

# Kogen forwards only an allow-list of controller variables; copy named extras into the project env.
for key in os.environ.get("KOGEN_BENCH_ENV_PASSTHROUGH", "").split():
    if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key) and key in os.environ:
        env.setdefault(key, os.environ[key])

if any(not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key) for key in env):
    raise SystemExit("task.json env keys must be environment variable names")

extra_path = env.get("BENCH_EXTRA_PATH", "")
toolchain_override = os.environ.get("KOGEN_BENCH_EXTRA_PATH")
if toolchain_override:
    extra_path = toolchain_override
    env["BENCH_EXTRA_PATH"] = extra_path
if extra_path:
    env["PATH"] = extra_path + (":" + env["PATH"] if env.get("PATH") else "")

mise_path = shutil.which("mise")
if mise_path:
    mise_bin = os.path.dirname(mise_path)
    env["PATH"] = mise_bin + (":" + env["PATH"] if env.get("PATH") else "")

mise_config = os.environ.get("KOGEN_BENCH_MISE_CONFIG")
if mise_config:
    if not mise_path:
        raise SystemExit("KOGEN_BENCH_MISE_CONFIG requires mise on PATH")
    env["MISE_CONFIG_FILE"] = mise_config

prefix = ["mise", "exec", "--"] if mise_path else []
if not prefix and not (env.get("PATH") and shutil.which("mix", path=env["PATH"])):
    prefix = ["mise", "exec", "--"]
quote = lambda value: json.dumps(str(value), ensure_ascii=False)
array = lambda values: "[" + ", ".join(quote(value) for value in values) + "]"
timer_prefix = [sys.executable, timer_path, phase_path, event_path]
timed = lambda name, argv: timer_prefix + [name, "--"] + argv

lines = [
    "name: kogen-bench",
    "format: " + array(timed("format", prefix + ["mix", "format"])),
    "checks:",
    "  - name: tests",
    "    argv: " + array(timed("check:tests", prefix + ["mix", "test"])),
    "    timeout_ms: 900000",
    "  - name: format",
    "    argv: " + array(timed("check:format", prefix + ["mix", "format", "--check-formatted"])),
    "    timeout_ms: 300000",
    "acceptance_checks:",
    "  - name: compile-acceptance",
    "    argv: " + array(timed("acceptance:compile-acceptance", prefix + ["mix", "test", "--dry-run", "{path}"])),
    "    timeout_ms: 600000",
    "  - name: format-acceptance",
    "    argv: " + array(timed("acceptance:format-acceptance", prefix + ["mix", "format", "--check-formatted", "{path}"])),
    "    timeout_ms: 300000",
]

raw_setup = document.get("setup")
deps_source_override = os.environ.get("KOGEN_BENCH_DEPS_SOURCE")
if deps_source_override and isinstance(raw_setup, str):
    copy_step = re.match(r"\s*cp\s+-cR\s+\S+\s+deps\s+&&\s*(.*)$", raw_setup, re.DOTALL)
    if not copy_step:
        raise SystemExit("KOGEN_BENCH_DEPS_SOURCE requires setup to begin by copying deps")
    env["BENCH_DEPS_SOURCE"] = deps_source_override
    raw_setup = 'cp -cR "$BENCH_DEPS_SOURCE" deps && ' + copy_step.group(1)

if isinstance(raw_setup, str) and ".setup-compile.log" in raw_setup:
    task_tmpdir = env.get("TMPDIR") or os.environ.get("TMPDIR", "/tmp")
    scratch_name = os.path.basename(os.path.dirname(os.path.dirname(os.path.dirname(target_path))))
    task_slug = os.path.basename(os.path.dirname(source_path))
    setup_log_path = os.path.join(task_tmpdir, f"{scratch_name}-{task_slug}-setup.log")
    env["BENCH_SETUP_LOG"] = setup_log_path
    raw_setup = raw_setup.replace(".setup-compile.log", '"$BENCH_SETUP_LOG"')

if isinstance(raw_setup, str) and raw_setup.strip():
    setup_argv = prefix + ["sh", "-c", raw_setup]
elif isinstance(raw_setup, list) and raw_setup and all(isinstance(part, str) for part in raw_setup):
    setup_argv = prefix + raw_setup
elif isinstance(raw_setup, dict) and isinstance(raw_setup.get("argv"), list):
    setup_argv = prefix + [str(part) for part in raw_setup["argv"]]
else:
    setup_argv = []

if setup_argv:
    setup_argv = timed("setup:task-setup", setup_argv)
    lines += [
        "setup:",
        "  - name: task-setup",
        "    argv: " + array(setup_argv),
        "    timeout_ms: 900000",
    ]

if env:
    lines.append("env:")
    lines.extend("  " + key + ": " + quote(value) for key, value in sorted(env.items()))

lines += ["domains:", "  app: [lib, test]"]
with open(target_path, "w", encoding="utf-8") as target:
    target.write("\n".join(lines) + "\n")
with open(tmpdir_path, "w", encoding="utf-8") as target:
    target.write(env.get("TMPDIR") or os.environ.get("TMPDIR", "/tmp"))
PY

git -C "$project_dir" add .kogen/project.yaml
git -C "$project_dir" -c user.name='Kogen Bench' -c user.email='kogen-bench@invalid' \
  -c commit.gpgsign=false commit --quiet -m 'Configure Kogen benchmark project'
git clone --quiet --bare "$project_dir" "$origin"
git --git-dir="$origin" symbolic-ref HEAD refs/heads/main
base_sha=$(git --git-dir="$origin" rev-parse refs/heads/main)

if [ -n "${KOGEN_BENCH_MISE_CONFIG:-}" ]; then
  bench_mise_config_dir=$(dirname "$KOGEN_BENCH_MISE_CONFIG")
  export MISE_CONFIG_FILE="$KOGEN_BENCH_MISE_CONFIG"
  export MISE_TRUSTED_CONFIG_PATHS="$project_dir:$bench_mise_config_dir"
else
  export MISE_TRUSTED_CONFIG_PATHS="$project_dir"
fi

log_line() {
  python3 - "$log_file" "$1" <<'PY'
import datetime
import sys

path, line = sys.argv[1:]
stamp = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")
with open(path, "a", encoding="utf-8") as target:
    target.write(f"[{stamp}] {line}\n")
PY
}

log_file_timestamped() {
  python3 - "$1" "$log_file" <<'PY'
import datetime
import sys

source_path, target_path = sys.argv[1:]
with open(source_path, encoding="utf-8", errors="replace") as source:
    with open(target_path, "a", encoding="utf-8") as target:
        for line in source:
            stamp = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")
            target.write(f"[{stamp}] {line.rstrip()}\n")
PY
}

run_capture() {
  name=$1
  capture=$2
  shift 2
  capture_started=$(python3 -c 'import time; print(time.monotonic_ns())')
  capture_started_at=$(python3 -c 'import time; print(time.time_ns() // 1000000)')
  printf '%s\n' "$name" > "$phase_file"
  log_line "--- $name ---"
  if "$@" > "$capture" 2>"$capture.stderr"; then
    status=0
  else
    status=$?
  fi
  capture_finished=$(python3 -c 'import time; print(time.monotonic_ns())')
  capture_finished_at=$(python3 -c 'import time; print(time.time_ns() // 1000000)')
  CAPTURE_WALL_MS=$(((capture_finished - capture_started) / 1000000))
  CAPTURE_STARTED_AT=$capture_started_at
  CAPTURE_FINISHED_AT=$capture_finished_at
  log_file_timestamped "$capture.stderr"
  log_file_timestamped "$capture"
  rm -f "$capture.stderr"
  if [ "$name" = report ]; then
    python3 - "$timings_file" "$CAPTURE_WALL_MS" "$CAPTURE_STARTED_AT" "$CAPTURE_FINISHED_AT" <<'PY'
import json
import sys

path, wall_ms, started_at, finished_at = sys.argv[1:]
row = {
    "event": "phase_timing",
    "phase": "report",
    "name": "cli",
    "wall_ms": int(wall_ms),
    "started_at": int(started_at),
    "finished_at": int(finished_at),
}
with open(path, "a", encoding="utf-8") as target:
    target.write(json.dumps(row, separators=(",", ":")) + "\n")
PY
  fi
  if [ "$status" -ne 0 ]; then
    log_line "$name failed with exit $status"
    return "$status"
  fi
}

copy_shaper_setup_logs() {
  for setup_log in "$shaper_root"/*/logs/shape-setup-*.log; do
    [ -f "$setup_log" ] || continue
    cp "$setup_log" "$out_dir/$(basename "$setup_log")"
  done
}

copy_bench_setup_log() {
  [ ! -f "$setup_log_path" ] || cp "$setup_log_path" "$out_dir/task-setup.log"
}

write_failed_usage() {
  failed_stage=$1
  failed_model=$2
  failed_effort=$3
  failed_status=$4
  failed_wall_ms=$5
  failed_finished_ns=$(python3 -c 'import time; print(time.monotonic_ns())')
  python3 - "$out_dir/shape.json" "$out_dir/report.json" "$out_dir/usage.json" \
    "$failed_stage" "$failed_model" "$failed_effort" "$failed_status" "$failed_wall_ms" \
    "$shaper_root" "$recipe" "$timings_file" "$events_file" \
    "$bench_started_ns" "$failed_finished_ns" <<'PY'
import json
import os
import sys
from pathlib import Path

(
    shape_path, report_path, output_path, failed_stage, failed_model, failed_effort,
    status, wall_ms, transcript_root, recipe, timing_input, events_output, started_ns, finished_ns,
) = sys.argv[1:]
started_ns = int(started_ns)
finished_ns = int(finished_ns)
token_names = ("input", "cached_input", "output", "reasoning")

def load(path):
    try:
        with open(path, encoding="utf-8") as source:
            return json.load(source)
    except (FileNotFoundError, json.JSONDecodeError):
        return {}

def tokens(value):
    value = value or {}
    return {name: int(value.get(name, 0) or 0) for name in token_names}

def failed_shape_calls():
    transcripts = list(Path(transcript_root).glob("*/transcript.jsonl"))
    if not transcripts:
        return []
    transcript = max(transcripts, key=os.path.getmtime)
    calls = []
    try:
        with transcript.open(encoding="utf-8") as source:
            for line in source:
                row = json.loads(line)
                if row.get("event") != "model_usage" or row.get("stage") != "shape":
                    continue
                payload = row.get("payload", {})
                calls.append({
                    "model": payload.get("model"),
                    "effort": payload.get("effort"),
                    "tokens": tokens(payload.get("tokens")),
                    "wall_ms": int(payload.get("wall_ms", 0) or 0),
                    "usage_available": True,
                })
    except (OSError, json.JSONDecodeError):
        return []
    return calls

shape = load(shape_path)
report = load(report_path)
stages = []
shape_calls = [
    {
        "model": call.get("model"),
        "effort": call.get("effort"),
        "tokens": tokens(call.get("tokens")),
        "wall_ms": int(call.get("wall_ms", 0) or 0),
    }
    for call in shape.get("usage", [])
]
if not shape_calls and failed_stage == "shape":
    shape_calls = failed_shape_calls()

if shape_calls:
    stages.append({
        "stage": "shape",
        "model": shape_calls[0]["model"],
        "effort": shape_calls[0]["effort"],
        "calls": shape_calls,
        "tokens": {name: sum(call["tokens"][name] for call in shape_calls) for name in token_names},
        "wall_ms": sum(call["wall_ms"] for call in shape_calls),
        "usage_available": all(call.get("usage_available", True) for call in shape_calls),
        "usage_complete": failed_stage != "shape",
    })
elif failed_stage == "shape":
    stages.append({
        "stage": "shape",
        "model": failed_model,
        "effort": failed_effort,
        "calls": [{"tokens": tokens(None), "wall_ms": 0}],
        "tokens": tokens(None),
        "wall_ms": 0,
        "usage_available": False,
        "usage_complete": False,
        "wall_time_source": "No model usage response; elapsed time remains in the total remainder",
    })

for stage in report.get("model_stages", []):
    stage_tokens = tokens(stage.get("tokens"))
    stages.append({
        "stage": stage.get("stage"),
        "model": stage.get("model"),
        "effort": stage.get("effort"),
        "calls": [{"tokens": stage_tokens, "wall_ms": int(stage.get("wall_ms", 0) or 0)}],
        "tokens": stage_tokens,
        "wall_ms": int(stage.get("wall_ms", 0) or 0),
        "usage_available": True,
    })

if failed_model and failed_stage != "shape":
    stages.append({
        "stage": failed_stage,
        "model": failed_model,
        "effort": failed_effort,
        "calls": [{"tokens": tokens(None), "wall_ms": int(wall_ms)}],
        "tokens": tokens(None),
        "wall_ms": int(wall_ms),
        "usage_available": False,
        "wall_time_source": "CLI stage elapsed time; model timing is unavailable",
    })

try:
    with open(timing_input, encoding="utf-8") as source:
        event_rows = [json.loads(line) for line in source if line.strip()]
except (FileNotFoundError, json.JSONDecodeError):
    event_rows = []

for timing in report.get("phase_timings", []):
    event_rows.append({"event": "phase_timing", **timing})

phase_events = [
    row for row in event_rows
    if row.get("event") == "phase_timing"
    and isinstance(row.get("phase"), str)
    and isinstance(row.get("name"), str)
    and isinstance(row.get("wall_ms"), int)
]
phase_events.sort(key=lambda row: int(row.get("started_at", 0) or 0))
intervals = sorted(
    (int(row["started_at"]), int(row["finished_at"]))
    for row in phase_events
    if isinstance(row.get("started_at"), int)
    and isinstance(row.get("finished_at"), int)
    and row["finished_at"] >= row["started_at"]
)
union_ms = 0
if intervals:
    interval_start, interval_end = intervals[0]
    for next_start, next_end in intervals[1:]:
        if next_start <= interval_end:
            interval_end = max(interval_end, next_end)
        else:
            union_ms += interval_end - interval_start
            interval_start, interval_end = next_start, next_end
    union_ms += interval_end - interval_start

end_to_end_wall_ms = max((finished_ns - started_ns) // 1_000_000, 0)
phase_wall_ms = min(union_ms, end_to_end_wall_ms)
model_wall_ms = sum(
    int(stage.get("wall_ms", 0) or 0)
    for stage in stages
    if stage.get("usage_available") is True
)
with open(events_output, "w", encoding="utf-8") as output:
    for row in event_rows:
        if row.get("event") == "phase_timing":
            output.write(json.dumps(row, separators=(",", ":")) + "\n")

phases = [
    {"phase": row["phase"], "name": row["name"], "wall_ms": row["wall_ms"]}
    for row in phase_events
]

totals = {name: sum(stage["tokens"][name] for stage in stages) for name in token_names}
result = {
    "recipe": recipe,
    "run_status": "failed",
    "status": "failed",
    "failed_stage": failed_stage,
    "exit_code": int(status),
    "stages": stages,
    "phases": phases,
    "total": {
        "tokens": totals,
        "wall_ms": end_to_end_wall_ms,
        "model_wall_ms": model_wall_ms,
        "phase_wall_ms": phase_wall_ms,
        "unaccounted_wall_ms": max(end_to_end_wall_ms - phase_wall_ms - model_wall_ms, 0),
    },
}
with open(output_path, "w", encoding="utf-8") as output:
    json.dump(result, output, indent=2)
    output.write("\n")
PY
}

slug=$(basename "$task_dir")
runtime_tmpdir=$(cat "$scratch/project_tmpdir")
setup_log_path="${runtime_tmpdir%/}/$(basename "$scratch")-$slug-setup.log"
shaper_root="${runtime_tmpdir%/}/kogen-shaper/$slug"
if run_capture shape "$out_dir/shape.json" "$KOGEN_BIN" intent shape "$slug" \
  --task-file "$prompt_file" --project "$project_dir" --origin "$origin" \
  --base main --model gpt-6-luna --effort max --json; then
  :
else
  stage_status=$?
  copy_bench_setup_log
  copy_shaper_setup_logs
  write_failed_usage shape gpt-6-luna max "$stage_status" "$CAPTURE_WALL_MS"
  exit "$stage_status"
fi
copy_bench_setup_log

if run_capture approve "$scratch/approve.txt" "$KOGEN_BIN" approve "$slug" \
  --project "$project_dir" --origin "$origin" --base main --by kogen-bench --yes; then
  :
else
  stage_status=$?
  write_failed_usage approve "" "" "$stage_status" "$CAPTURE_WALL_MS"
  exit "$stage_status"
fi

if run_capture build "$scratch/build.txt" "$KOGEN_BIN" build "$slug" \
  --project "$project_dir" --origin "$origin" --base main \
  --model gpt-6-luna --effort max --recipe "$recipe"; then
  :
else
  stage_status=$?
  write_failed_usage build gpt-6-luna max "$stage_status" "$CAPTURE_WALL_MS"
  exit "$stage_status"
fi

if run_capture report "$out_dir/report.json" "$KOGEN_BIN" report "$slug" \
  --project "$project_dir" --origin "$origin" --base main --json; then
  :
else
  stage_status=$?
  write_failed_usage report "" "" "$stage_status" "$CAPTURE_WALL_MS"
  exit "$stage_status"
fi

git --git-dir="$origin" diff --binary "$base_sha" refs/heads/main > "$out_dir/final.diff"
git -C "$work_dir" apply --check "$out_dir/final.diff"
git -C "$work_dir" apply "$out_dir/final.diff"
[ "$(git -C "$work_dir" rev-parse HEAD)" = "$work_base" ] || {
  echo "work_dir base moved during benchmark" >&2
  exit 4
}

log_line "--- landed diff applied to work_dir ---"
git -C "$work_dir" status --short | while IFS= read -r line; do log_line "$line"; done
log_line "work_dir base: $work_base"
log_line "Kogen landed: $(git --git-dir="$origin" rev-parse refs/heads/main)"
bench_finished_ns=$(python3 -c 'import time; print(time.monotonic_ns())')

python3 - "$out_dir/shape.json" "$out_dir/report.json" "$out_dir/usage.json" \
  "$recipe" "$timings_file" "$events_file" "$bench_started_ns" "$bench_finished_ns" <<'PY'
import json
import sys

shape_path, report_path, output_path, recipe, timing_input, events_output, started_ns, finished_ns = sys.argv[1:]
started_ns = int(started_ns)
finished_ns = int(finished_ns)
with open(shape_path, encoding="utf-8") as source:
    shape = json.load(source)
with open(report_path, encoding="utf-8") as source:
    report = json.load(source)

token_names = ("input", "cached_input", "output", "reasoning")

def normalized_tokens(tokens):
    tokens = tokens or {}
    return {name: int(tokens.get(name, 0) or 0) for name in token_names}

def sum_tokens(rows):
    return {name: sum(row["tokens"][name] for row in rows) for name in token_names}

shape_calls = [
    {
        "model": call["model"],
        "effort": call["effort"],
        "tokens": normalized_tokens(call.get("tokens")),
        "wall_ms": int(call.get("wall_ms", 0) or 0),
    }
    for call in shape.get("usage", [])
]

stages = []
if shape_calls:
    stages.append({
        "stage": "shape",
        "model": shape_calls[0]["model"],
        "effort": shape_calls[0]["effort"],
        "calls": shape_calls,
        "tokens": sum_tokens(shape_calls),
        "wall_ms": sum(call["wall_ms"] for call in shape_calls),
        "usage_available": True,
    })

for stage in report.get("model_stages", []):
    tokens = normalized_tokens(stage.get("tokens"))
    stages.append({
        "stage": stage.get("stage"),
        "model": stage.get("model"),
        "effort": stage.get("effort"),
        "calls": [{"tokens": tokens, "wall_ms": int(stage.get("wall_ms", 0) or 0)}],
        "tokens": tokens,
        "wall_ms": int(stage.get("wall_ms", 0) or 0),
        "usage_available": True,
    })

with open(timing_input, encoding="utf-8") as source:
    event_rows = [json.loads(line) for line in source if line.strip()]

for timing in report.get("phase_timings", []):
    event_rows.append({"event": "phase_timing", **timing})

phase_events = [
    row for row in event_rows
    if row.get("event") == "phase_timing"
    and isinstance(row.get("phase"), str)
    and isinstance(row.get("name"), str)
    and isinstance(row.get("wall_ms"), int)
]
phase_events.sort(key=lambda row: int(row.get("started_at", 0) or 0))

intervals = sorted(
    (int(row["started_at"]), int(row["finished_at"]))
    for row in phase_events
    if isinstance(row.get("started_at"), int)
    and isinstance(row.get("finished_at"), int)
    and row["finished_at"] >= row["started_at"]
)
union_ms = 0
if intervals:
    interval_start, interval_end = intervals[0]
    for next_start, next_end in intervals[1:]:
        if next_start <= interval_end:
            interval_end = max(interval_end, next_end)
        else:
            union_ms += interval_end - interval_start
            interval_start, interval_end = next_start, next_end
    union_ms += interval_end - interval_start

end_to_end_wall_ms = max((finished_ns - started_ns) // 1_000_000, 0)
phase_wall_ms = min(union_ms, end_to_end_wall_ms)
model_wall_ms = sum(
    int(stage.get("wall_ms", 0) or 0)
    for stage in stages
    if stage.get("usage_available") is True
)
with open(events_output, "w", encoding="utf-8") as output:
    for row in event_rows:
        if row.get("event") == "phase_timing":
            output.write(json.dumps(row, separators=(",", ":")) + "\n")

phases = [
    {"phase": row["phase"], "name": row["name"], "wall_ms": row["wall_ms"]}
    for row in phase_events
]

totals = {name: sum(stage["tokens"][name] for stage in stages) for name in token_names}
result = {
    "recipe": recipe,
    "slug": shape.get("slug"),
    "run_status": "complete",
    "status": report.get("status"),
    "roles": report.get("roles", {}),
    "stages": stages,
    "phases": phases,
    "total": {
        "tokens": totals,
        "wall_ms": end_to_end_wall_ms,
        "model_wall_ms": model_wall_ms,
        "phase_wall_ms": phase_wall_ms,
        "unaccounted_wall_ms": max(end_to_end_wall_ms - phase_wall_ms - model_wall_ms, 0),
    },
}
with open(output_path, "w", encoding="utf-8") as output:
    json.dump(result, output, indent=2)
    output.write("\n")
PY

printf 'benchmark complete\nwork_dir: %s\nusage: %s\nlog: %s\ndiff: %s\n' \
  "$work_dir" "$out_dir/usage.json" "$log_file" "$out_dir/final.diff"
