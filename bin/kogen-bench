#!/bin/sh
set -eu

usage() {
  echo "usage: kogen-bench <task_dir> <work_dir> <out_dir>" >&2
  exit 2
}

[ "$#" -eq 3 ] || usage
script_path=$0
case "$script_path" in
  */*) ;;
  *) script_path=$(command -v "$script_path") ;;
esac
script_dir=$(cd "$(dirname "$script_path")" && pwd -P)
format_check_script="$script_dir/kogen-format-check"
recipe=${KOGEN_BENCH_RECIPE:-ladder}
edge_tests=${KOGEN_BENCH_EDGE_TESTS:-0}
case "$edge_tests" in
  0|1) ;;
  *) echo "KOGEN_BENCH_EDGE_TESTS must be 0 or 1" >&2; exit 2 ;;
esac
# A ladder recipe with a +edge suffix runs the edge probe, like KOGEN_BENCH_EDGE_TESTS=1.
case "$recipe" in
  ladder|ladder-diverse|ladder-luna|ladder-sol-low|ladder-sol-medium|ladder-sol-high|staged|plan-shell|direct|direct-shell|direct-escalate|escalate-shell) ;;
  ladder+edge|ladder-diverse+edge|ladder-luna+edge|ladder-sol-low+edge|ladder-sol-medium+edge|ladder-sol-high+edge)
    recipe=${recipe%+edge}
    edge_tests=1
    ;;
  *) echo "KOGEN_BENCH_RECIPE must be ladder, ladder-diverse, ladder-luna, ladder-sol-low, ladder-sol-medium, ladder-sol-high (each optionally with +edge), staged, plan-shell, direct, direct-shell, direct-escalate, or escalate-shell" >&2; exit 2 ;;
esac
case "$edge_tests:$recipe" in
  1:ladder|1:ladder-diverse|1:ladder-luna|1:ladder-sol-low|1:ladder-sol-medium|1:ladder-sol-high|0:*) ;;
  *) echo "KOGEN_BENCH_EDGE_TESTS=1 needs a ladder recipe" >&2; exit 2 ;;
esac
export KOGEN_BENCH_EDGE_TESTS="$edge_tests"
# KOGEN_BENCH_NO_FALLBACK=1 keeps Kogen on the same model after repeated overloads (no fallback).
no_fallback=${KOGEN_BENCH_NO_FALLBACK:-0}
case "$no_fallback" in
  0|1) ;;
  *) echo "KOGEN_BENCH_NO_FALLBACK must be 0 or 1" >&2; exit 2 ;;
esac
export KOGEN_BENCH_NO_FALLBACK="$no_fallback"
format_scope=${KOGEN_BENCH_FORMAT_SCOPE:-changed}
case "$format_scope" in
  changed|all) ;;
  *) echo "KOGEN_BENCH_FORMAT_SCOPE must be changed or all" >&2; exit 2 ;;
esac
provider=${KOGEN_BENCH_PROVIDER:-chatgpt}
case "$provider" in
  chatgpt)
    default_model=gpt-6-luna
    default_effort=max
    default_shape_model=gpt-6.1-sol
    ;;
  grok)
    default_model=grok-4.6
    default_effort=high
    default_shape_model=grok-4.6
    ;;
  *) echo "KOGEN_BENCH_PROVIDER must be chatgpt or grok" >&2; exit 2 ;;
esac
export KOGEN_BENCH_PROVIDER="$provider"
builder_model=${KOGEN_BENCH_MODEL:-$default_model}
builder_effort=${KOGEN_BENCH_EFFORT:-$default_effort}
shape_model=${KOGEN_BENCH_SHAPE_MODEL:-$default_shape_model}
shape_effort=${KOGEN_BENCH_SHAPE_EFFORT:-high}
shape_fallback=${KOGEN_BENCH_SHAPE_FALLBACK:-raw}
case "$shape_fallback" in
  raw|none) ;;
  *) echo "KOGEN_BENCH_SHAPE_FALLBACK must be raw or none" >&2; exit 2 ;;
esac
provided_intent_dir=${KOGEN_BENCH_INTENT_DIR:-}
intent_source=shaped
[ -z "$provided_intent_dir" ] || intent_source=provided
# raw skips shaping: the Intent is the verbatim prompt with no Kogen-written acceptance items,
# so the gate is the project's own checks.
case "${KOGEN_BENCH_INTENT_SOURCE:-shaped}" in
  shaped) ;;
  raw)
    [ -z "$provided_intent_dir" ] || {
      echo "KOGEN_BENCH_INTENT_SOURCE=raw cannot be combined with KOGEN_BENCH_INTENT_DIR" >&2
      exit 2
    }
    intent_source=raw
    ;;
  *) echo "KOGEN_BENCH_INTENT_SOURCE must be shaped or raw" >&2; exit 2 ;;
esac
task_dir=$(cd "$1" && pwd -P)
work_dir=$(cd "$2" && pwd -P)
mkdir -p "$3"
out_dir=$(cd "$3" && pwd -P)
task_json="$task_dir/task.json"
prompt_file="$task_dir/prompt.md"
log_file="$out_dir/log.txt"

[ -f "$task_json" ] || { echo "missing task.json" >&2; exit 2; }
[ -f "$prompt_file" ] || { echo "missing prompt.md" >&2; exit 2; }
[ -d "$work_dir/.git" ] || [ -f "$work_dir/.git" ] || {
  echo "work_dir must be a git checkout" >&2
  exit 2
}

KOGEN_BIN=${KOGEN_BIN:-$(command -v kogen || true)}
[ -n "$KOGEN_BIN" ] && [ -x "$KOGEN_BIN" ] || {
  echo "kogen executable not found; set KOGEN_BIN or add kogen to PATH" >&2
  exit 3
}
if "$KOGEN_BIN" version >/dev/null 2>&1; then
  kogen_cli_mode=modern
else
  kogen_cli_mode=semantic
fi

# A benchmark work_dir is a throwaway clone. Refuse shared task bases and result trees.
case "$work_dir/" in
  */bench/tasks/*|*/bench/night-*/*|/srv/bh/bench/tasks/*)
    echo "work_dir must be a fresh clone, not a shared benchmark tree: $work_dir" >&2
    exit 2
    ;;
esac
case "$out_dir/" in
  */bench/night-*/*|*/bench/tasks/*)
    echo "out_dir must not be inside a shared benchmark tree: $out_dir" >&2
    exit 2
    ;;
esac

work_base=$(git -C "$work_dir" rev-parse HEAD)
work_status=$(git -C "$work_dir" status --porcelain --untracked-files=all)
[ -z "$work_status" ] || {
  echo "work_dir must be clean before the benchmark starts" >&2
  exit 2
}

bench_tmpdir=$(python3 - "$task_json" <<'PY'
import json
import os
import sys

with open(sys.argv[1], encoding="utf-8") as source:
    document = json.load(source)
env = document.get("env", {})
if isinstance(env, list):
    env = dict(entry.split("=", 1) for entry in env if isinstance(entry, str) and "=" in entry)
if not isinstance(env, dict):
    env = {}
print(os.path.abspath(env.get("TMPDIR") or os.environ.get("TMPDIR") or "/tmp"))
PY
)
mkdir -p "$bench_tmpdir"
scratch=$(mktemp -d "${bench_tmpdir%/}/kogen-bench.XXXXXX")
bench_started_at=$(python3 -c 'import time; print(time.time())')
# Every run, however it ends, leaves its model-request journal beside usage.json.
copy_requests() {
  python3 - "$out_dir" "${slug:-}" "${shaper_root:-}" "${HOME:-}" "$bench_started_at" <<'PY' || :
import glob
import json
import os
import sys

out_dir, slug, shaper_root, home, started_at = sys.argv[1:]
started_at = float(started_at) - 1.0


def fresh(path):
    return os.path.isfile(path) and os.path.getmtime(path) >= started_at


def read_json(path):
    try:
        with open(path, encoding="utf-8") as source:
            return json.load(source)
    except (OSError, ValueError):
        return {}


sources = []
if shaper_root:
    shaped = [path for path in glob.glob(os.path.join(shaper_root, "*", "requests.jsonl")) if fresh(path)]
    sources += sorted(shaped, key=os.path.getmtime)

journal = read_json(os.path.join(out_dir, "report.json")).get("journal")
if isinstance(journal, str) and os.path.isfile(os.path.join(journal, "requests.jsonl")):
    sources.append(os.path.join(journal, "requests.jsonl"))
elif slug and home:
    pattern = os.path.join(home, ".kogen", "workspaces", "*", "runs", "*", "requests.jsonl")
    runs = [
        path for path in glob.glob(pattern)
        if fresh(path) and read_json(os.path.join(os.path.dirname(path), "run.json")).get("slug") == slug
    ]
    sources += sorted(runs, key=os.path.getmtime)

with open(os.path.join(out_dir, "requests.jsonl"), "w", encoding="utf-8") as target:
    for source_path in sources:
        with open(source_path, encoding="utf-8", errors="replace") as source:
            for line in source:
                if line.strip():
                    target.write(line.rstrip("\n") + "\n")

usage_path = os.path.join(out_dir, "usage.json")
usage = read_json(usage_path)
role_stages = {
    "shape": "shaper", "plan": "planner", "develop": "builder",
    "context": "context", "review": "reviewer", "audit": "auditor", "edge": "edge_writer",
}
roles = {}
with open(os.path.join(out_dir, "requests.jsonl"), encoding="utf-8") as source:
    for line in source:
        try:
            row = json.loads(line)
        except ValueError:
            continue
        role = role_stages.get(row.get("stage"))
        model, effort = row.get("model"), row.get("effort")
        if role and isinstance(model, str) and isinstance(effort, str):
            settings = {"model": model, "effort": effort}
            used = roles.setdefault(role, [])
            if settings not in used:
                used.append(settings)
if usage:
    build_tokens = [stage.get("tokens") or {} for stage in usage.get("stages", [])
                    if stage.get("stage") != "shape"]
    uncached = sum(int(tokens.get("input", 0) or 0) for tokens in build_tokens)
    cached = sum(int(tokens.get("cached_input", 0) or 0) for tokens in build_tokens)
    usage["cache_hit_rate"] = cached / (uncached + cached) if uncached + cached else None
    usage["roles"] = roles
    usage["builder_models"] = sorted({settings["model"] for settings in roles.get("builder", [])})
    with open(usage_path, "w", encoding="utf-8") as output:
        json.dump(usage, output, indent=2)
        output.write("\n")
PY
}
trap 'copy_requests; rm -rf "$scratch"' EXIT
project_dir="$scratch/project"
origin="$scratch/origin.git"
events_file="$out_dir/events.jsonl"
timings_file="$scratch/phase-events.jsonl"
phase_file="$scratch/phase"
timer_script="$scratch/bench_timer.py"
bench_started_ns=$(python3 -c 'import time; print(time.monotonic_ns())')
mkdir -p "$out_dir"
: > "$log_file"
: > "$out_dir/final.diff"
rm -f "$out_dir/candidate.diff" "$out_dir"/candidate-*.diff
rm -f "$out_dir/report.json" "$out_dir/shape.json" "$out_dir/requests.jsonl"
: > "$timings_file"
: > "$events_file"
printf 'shape\n' > "$phase_file"
cat > "$timer_script" <<'PY'
import json
import subprocess
import sys
import time

phase_path, event_path, name = sys.argv[1:4]
argv = sys.argv[5:]
if argv[:1] == ["--"]:
    argv = argv[1:]
if not argv:
    raise SystemExit("benchmark timer requires a command")

phase = open(phase_path, encoding="utf-8").read().strip()
started_at = time.time_ns() // 1_000_000
started = time.monotonic_ns()
status = subprocess.run(argv, check=False).returncode
wall_ms = max((time.monotonic_ns() - started) // 1_000_000, 0)
finished_at = time.time_ns() // 1_000_000
row = {
    "event": "phase_timing",
    "phase": phase,
    "name": name,
    "wall_ms": int(wall_ms),
    "started_at": int(started_at),
    "finished_at": int(finished_at),
}
with open(event_path, "a", encoding="utf-8") as target:
    target.write(json.dumps(row, separators=(",", ":")) + "\n")
raise SystemExit(status)
PY
python3 - "$out_dir/usage.json" "$recipe" "$builder_model" "$builder_effort" \
  "$shape_model" "$shape_effort" "$intent_source" <<'PY'
import json
import os
import sys

path, recipe, model, effort, shape_model, shape_effort, intent_source = sys.argv[1:]
provider = os.environ.get("KOGEN_BENCH_PROVIDER", "chatgpt")
egress_hosts = ["auth.x.ai", "accounts.x.ai", "grok.com", "cli-chat-proxy.grok.com"] if provider == "grok" else []
with open(path, "w", encoding="utf-8") as output:
    json.dump({
        "provider": provider,
        "egress_hosts": egress_hosts,
        "recipe": recipe,
        "edge_tests": os.environ.get("KOGEN_BENCH_EDGE_TESTS") == "1",
        "model_fallback": os.environ.get("KOGEN_BENCH_NO_FALLBACK") != "1",
        "intent_source": intent_source,
        "builder": {"model": model, "effort": effort},
        "shape": {"model": shape_model, "effort": shape_effort, "wall_ms": None},
        "status": "not_started",
        "stages": [],
        "attempts": [],
        "candidate_diffs": [],
        "total": {
            "tokens": {"input": 0, "cached_input": 0, "output": 0, "reasoning": 0},
            "wall_ms": 0,
        },
    }, output, indent=2)
    output.write("\n")
PY

git clone --quiet "$work_dir" "$project_dir"
git -C "$project_dir" checkout --quiet -B main "$work_base"
mkdir -p "$project_dir/.kogen"
acceptance_ext=exs
if [ -f "$project_dir/Gemfile" ] && [ -f "$project_dir/config/application.rb" ]; then
  acceptance_ext=rb
fi
python3 - "$task_json" "$project_dir/.kogen/project.yaml" "$scratch/project_tmpdir" \
  "$timer_script" "$phase_file" "$timings_file" "$format_check_script" "$format_scope" \
  "$recipe" "$builder_model" "$builder_effort" "$shape_model" "$shape_effort" <<'PY'
import json
import os
import re
import shutil
import subprocess
import sys

(
    source_path, target_path, tmpdir_path, timer_path, phase_path, event_path,
    format_check_script, format_scope, recipe, builder_model, builder_effort, shape_model, shape_effort,
) = sys.argv[1:]
with open(source_path, encoding="utf-8") as source:
    document = json.load(source)

raw_env = document.get("env", {})
if isinstance(raw_env, dict):
    env = {str(key): str(value) for key, value in raw_env.items()}
elif isinstance(raw_env, list):
    env = {}
    for entry in raw_env:
        if isinstance(entry, str) and "=" in entry:
            key, value = entry.split("=", 1)
            env[key] = value
else:
    env = {}

if env.get("TMPDIR"):
    env["TMPDIR"] = os.path.abspath(env["TMPDIR"])

# Kogen forwards only an allow-list of controller variables; copy named extras into the project env.
for key in os.environ.get("KOGEN_BENCH_ENV_PASSTHROUGH", "").split():
    if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key) and key in os.environ:
        env.setdefault(key, os.environ[key])

if any(not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key) for key in env):
    raise SystemExit("task.json env keys must be environment variable names")

extra_path = env.get("BENCH_EXTRA_PATH", "")
toolchain_override = os.environ.get("KOGEN_BENCH_EXTRA_PATH")
if toolchain_override:
    extra_path = toolchain_override
    env["BENCH_EXTRA_PATH"] = extra_path
if extra_path:
    env["PATH"] = extra_path + ":" + (env.get("PATH") or os.environ.get("PATH", "/usr/bin:/bin"))

mise_path = shutil.which("mise")
if mise_path:
    mise_bin = os.path.dirname(mise_path)
    env["PATH"] = mise_bin + ":" + (env.get("PATH") or os.environ.get("PATH", "/usr/bin:/bin"))

mise_config = os.environ.get("KOGEN_BENCH_MISE_CONFIG")
if mise_config:
    if not mise_path:
        raise SystemExit("KOGEN_BENCH_MISE_CONFIG requires mise on PATH")
    env["MISE_CONFIG_FILE"] = mise_config

project_root = os.path.dirname(os.path.dirname(target_path))
rails = os.path.isfile(os.path.join(project_root, "Gemfile")) and os.path.isfile(os.path.join(project_root, "config/application.rb"))
prefix = ["mise", "exec", "--"] if mise_path else []
runtime_available = shutil.which("ruby", path=env.get("PATH") or os.environ.get("PATH")) if rails else env.get("PATH") and shutil.which("mix", path=env["PATH"])
if not prefix and not runtime_available:
    prefix = ["mise", "exec", "--"]
raw_setup = document.get("setup")
if rails:
    # The public environment patch is part of the task base, before approval hashes it.
    # Keep the remaining public setup commands; each workspace installs its bundle locally.
    patch_path = os.path.join(os.path.dirname(source_path), "environment.patch")
    patch_command = r"git\s+apply\s+(?:--[\w-]+(?:=[^\s;&|]+)?\s+)*(?:\"[^\"]*environment\.patch\"|'[^']*environment\.patch'|[^\s;&|]*environment\.patch)(?=\s*(?:&&|;|$))"
    patch_setup = isinstance(raw_setup, str) and re.search(patch_command, raw_setup)
    patch_argv = raw_setup.get("argv") if isinstance(raw_setup, dict) else raw_setup
    if isinstance(patch_argv, list):
        patch_setup = patch_argv[:2] == ["git", "apply"] and any("environment.patch" in arg for arg in patch_argv[2:])
    if patch_setup:
        if not os.path.isfile(patch_path):
            raise SystemExit("Rails setup references environment.patch but the public task file is missing")
        patch_noop_reason = None
        if os.path.getsize(patch_path) == 0:
            patch_noop_reason = "empty environment.patch is not applicable; no-op"
        elif subprocess.run(["git", "apply", "--check", "--reverse", patch_path], cwd=project_root, capture_output=True).returncode == 0:
            patch_noop_reason = "environment.patch is already applied; no-op"
        elif subprocess.run(["git", "apply", "--check", patch_path], cwd=project_root, capture_output=True).returncode == 0:
            subprocess.run(["git", "apply", patch_path], cwd=project_root, check=True)
        else:
            raise SystemExit("Rails environment.patch does not apply to the task base")
        shutil.copyfile(patch_path, os.path.join(os.path.dirname(event_path), "environment.patch"))
        raw_setup = re.sub(patch_command, ":", raw_setup) if isinstance(raw_setup, str) else []
        if patch_noop_reason:
            task_tmpdir = env.get("TMPDIR") or os.environ.get("TMPDIR", "/tmp")
            scratch_name = os.path.basename(os.path.dirname(os.path.dirname(os.path.dirname(target_path))))
            task_slug = os.path.basename(os.path.dirname(source_path))
            setup_log_path = os.path.join(task_tmpdir, f"{scratch_name}-{task_slug}-setup.log")
            os.makedirs(os.path.dirname(setup_log_path), exist_ok=True)
            with open(setup_log_path, "a", encoding="utf-8") as setup_log:
                setup_log.write(patch_noop_reason + "\n")
quote = lambda value: json.dumps(str(value), ensure_ascii=False)
array = lambda values: "[" + ", ".join(quote(value) for value in values) + "]"
timer_prefix = [sys.executable, timer_path, phase_path, event_path]
timed = lambda name, argv: timer_prefix + [name, "--"] + argv
if rails:
    declarations = ""
    for filename in ("Gemfile", "Gemfile.lock"):
        path = os.path.join(project_root, filename)
        if os.path.isfile(path):
            with open(path, encoding="utf-8") as source:
                declarations += source.read() + "\n"
    linters = []
    for name, command, config in (("standard", "standardrb", ".standard.yml"), ("rubocop", "rubocop", ".rubocop.yml")):
        pattern = r"\bgem\s+[\"']" + name + r"(?:-[\w-]+)?[\"']|^    " + name + r" \("
        if os.path.isfile(os.path.join(project_root, config)) or re.search(pattern, declarations, re.MULTILINE):
            linters.append((name, prefix + ["bundle", "exec", command]))
    lines = ["name: kogen-bench"]
    if linters:
        lines.append("format: " + array(timed("format", linters[0][1] + ["-a"])))
    lines += ["checks:", "  - name: tests", "    argv: " + array(timed("check:tests", prefix + ["bundle", "exec", "rails", "test"])), "    timeout_ms: 900000"]
    for name, argv in linters:
        lines += ["  - name: " + name, "    argv: " + array(timed("check:" + name, argv)), "    timeout_ms: 300000"]
    lines += ["acceptance_checks:", "  - name: syntax-acceptance", "    argv: " + array(timed("acceptance:syntax", prefix + ["ruby", "-c", "{path}"])), "    timeout_ms: 60000"]
else:
    if format_scope == "all":
        format_argv = prefix + ["mix", "format"]
    else:
        format_argv = [sys.executable, format_check_script] + prefix + ["mix", "format"]

    lines = [
        "name: kogen-bench",
        "format: " + array(timed("format", format_argv)),
        "checks:",
        "  - name: tests",
        "    argv: " + array(timed("check:tests", prefix + ["mix", "test"])),
        "    timeout_ms: 900000",
        "  - name: format",
        "    argv: " + array(timed("check:format", format_argv + ["--check-formatted"])),
        "    timeout_ms: 300000",
        "acceptance_checks:",
        "  - name: compile-acceptance",
        "    argv: " + array(timed("acceptance:compile-acceptance", prefix + ["mix", "test", "--dry-run", "{path}"])),
        "    timeout_ms: 600000",
        "  - name: format-acceptance",
        "    argv: " + array(timed("acceptance:format-acceptance", prefix + ["mix", "format", "--check-formatted", "{path}"])),
        "    timeout_ms: 300000",
    ]

lines += [
    "build:",
    "  recipe: " + quote(recipe),
] + (["  edge_tests: true"] if os.environ.get("KOGEN_BENCH_EDGE_TESTS") == "1" else []) + [
    "  model_fallback: " + ("false" if os.environ.get("KOGEN_BENCH_NO_FALLBACK") == "1" else "true"),
    "  roles:",
    "    builder:",
    "      model: " + quote(builder_model),
    "      effort: " + quote(builder_effort),
    "    shaper:",
    "      model: " + quote(shape_model),
    "      effort: " + quote(shape_effort),
]

deps_source_override = os.environ.get("KOGEN_BENCH_DEPS_SOURCE")
if not rails and deps_source_override and isinstance(raw_setup, str):
    copy_step = re.match(r"\s*cp\s+-cR\s+\S+\s+deps\s+&&\s*(.*)$", raw_setup, re.DOTALL)
    if not copy_step:
        raise SystemExit("KOGEN_BENCH_DEPS_SOURCE requires setup to begin by copying deps")
    env["BENCH_DEPS_SOURCE"] = deps_source_override
    raw_setup = 'cp -cR "$BENCH_DEPS_SOURCE" deps && ' + copy_step.group(1)

if isinstance(raw_setup, str) and ".setup-compile.log" in raw_setup:
    task_tmpdir = env.get("TMPDIR") or os.environ.get("TMPDIR", "/tmp")
    scratch_name = os.path.basename(os.path.dirname(os.path.dirname(os.path.dirname(target_path))))
    task_slug = os.path.basename(os.path.dirname(source_path))
    setup_log_path = os.path.join(task_tmpdir, f"{scratch_name}-{task_slug}-setup.log")
    env["BENCH_SETUP_LOG"] = setup_log_path
    raw_setup = raw_setup.replace(".setup-compile.log", '"$BENCH_SETUP_LOG"')

if isinstance(raw_setup, str) and raw_setup.strip():
    setup_argv = prefix + ["sh", "-c", raw_setup]
elif isinstance(raw_setup, list) and raw_setup and all(isinstance(part, str) for part in raw_setup):
    setup_argv = prefix + raw_setup
elif isinstance(raw_setup, dict) and isinstance(raw_setup.get("argv"), list):
    setup_argv = prefix + [str(part) for part in raw_setup["argv"]]
else:
    setup_argv = []

if isinstance(raw_setup, str):
    setup_text = raw_setup
elif isinstance(raw_setup, list):
    setup_text = " ".join(str(part) for part in raw_setup)
elif isinstance(raw_setup, dict) and isinstance(raw_setup.get("argv"), list):
    setup_text = " ".join(str(part) for part in raw_setup["argv"])
else:
    setup_text = ""

if not rails and setup_argv and re.search(r"(?<![A-Za-z0-9_])mix(?=\s|$)", setup_text):
    lines.append("setup_outputs: [deps, _build]")

if setup_argv:
    setup_argv = timed("setup:task-setup", setup_argv)
    lines += [
        "setup:",
        "  - name: task-setup",
        "    argv: " + array(setup_argv),
        "    timeout_ms: 900000",
    ]

if rails:
    if not setup_argv:
        lines.append("setup:")
    lines += [
        "  - name: bundle-install",
        "    argv: " + array(timed("setup:bundle-install", prefix + ["sh", "-c", "bundle exec ruby -e 'exit' || GIT_ALLOW_PROTOCOL=file bundle install --local"])),
        "    timeout_ms: 900000",
    ]

if env:
    lines.append("env:")
    lines.extend("  " + key + ": " + quote(value) for key, value in sorted(env.items()))

lines += ["domains:", "  app: [app, config, db, lib, test]" if rails else "  app: [lib, test]"]
with open(target_path, "w", encoding="utf-8") as target:
    target.write("\n".join(lines) + "\n")
with open(tmpdir_path, "w", encoding="utf-8") as target:
    target.write(env.get("TMPDIR") or os.environ.get("TMPDIR", "/tmp"))
PY

git -C "$project_dir" add --all
git -C "$project_dir" -c user.name='Kogen Bench' -c user.email='kogen-bench@invalid' \
  -c commit.gpgsign=false commit --quiet -m 'Configure Kogen benchmark project'
git clone --quiet --bare "$project_dir" "$origin"
# The account is a machine choice, never committed: bind this throwaway project to it.
if [ -n "${KOGEN_BENCH_ACCOUNT:-}" ]; then
  "$KOGEN_BIN" provider use "$provider" --as "$KOGEN_BENCH_ACCOUNT" --project "$project_dir" >/dev/null
fi
git --git-dir="$origin" symbolic-ref HEAD refs/heads/main
base_sha=$(git --git-dir="$origin" rev-parse refs/heads/main)

if [ -n "${KOGEN_BENCH_MISE_CONFIG:-}" ]; then
  bench_mise_config_dir=$(dirname "$KOGEN_BENCH_MISE_CONFIG")
  export MISE_CONFIG_FILE="$KOGEN_BENCH_MISE_CONFIG"
  export MISE_TRUSTED_CONFIG_PATHS="$project_dir:$bench_mise_config_dir"
else
  export MISE_TRUSTED_CONFIG_PATHS="$project_dir"
fi

log_line() {
  python3 - "$log_file" "$1" <<'PY'
import datetime
import sys

path, line = sys.argv[1:]
stamp = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")
with open(path, "a", encoding="utf-8") as target:
    target.write(f"[{stamp}] {line}\n")
PY
}

log_file_timestamped() {
  python3 - "$1" "$log_file" <<'PY'
import datetime
import sys

source_path, target_path = sys.argv[1:]
with open(source_path, encoding="utf-8", errors="replace") as source:
    with open(target_path, "a", encoding="utf-8") as target:
        for line in source:
            stamp = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")
            target.write(f"[{stamp}] {line.rstrip()}\n")
PY
}

run_capture() {
  name=$1
  capture=$2
  shift 2
  capture_started=$(python3 -c 'import time; print(time.monotonic_ns())')
  capture_started_at=$(python3 -c 'import time; print(time.time_ns() // 1000000)')
  printf '%s\n' "$name" > "$phase_file"
  log_line "--- $name ---"
  if "$@" > "$capture" 2>"$capture.stderr"; then
    status=0
  else
    status=$?
  fi
  capture_finished=$(python3 -c 'import time; print(time.monotonic_ns())')
  capture_finished_at=$(python3 -c 'import time; print(time.time_ns() // 1000000)')
  CAPTURE_WALL_MS=$(((capture_finished - capture_started) / 1000000))
  CAPTURE_STARTED_AT=$capture_started_at
  CAPTURE_FINISHED_AT=$capture_finished_at
  log_file_timestamped "$capture.stderr"
  log_file_timestamped "$capture"
  rm -f "$capture.stderr"
  if [ "$name" = report ]; then
    python3 - "$timings_file" "$CAPTURE_WALL_MS" "$CAPTURE_STARTED_AT" "$CAPTURE_FINISHED_AT" <<'PY'
import json
import sys

path, wall_ms, started_at, finished_at = sys.argv[1:]
row = {
    "event": "phase_timing",
    "phase": "report",
    "name": "cli",
    "wall_ms": int(wall_ms),
    "started_at": int(started_at),
    "finished_at": int(finished_at),
}
with open(path, "a", encoding="utf-8") as target:
    target.write(json.dumps(row, separators=(",", ":")) + "\n")
PY
  fi
  if [ "$status" -ne 0 ]; then
    log_line "$name failed with exit $status"
    return "$status"
  fi
}

run_status_report() {
  if [ "$kogen_cli_mode" = semantic ]; then
    if run_capture report "$out_dir/report.json" "$KOGEN_BIN" build show "$slug" --json \
      --project "$project_dir" --origin "$origin" --base main; then
      return 0
    else
      report_status=$?
    fi
    case "$report_status" in
      2|90) ;;
      *) return "$report_status" ;;
    esac
  fi

  run_capture report "$out_dir/report.json" "$KOGEN_BIN" status "$slug" --json \
    --project "$project_dir" --origin "$origin" --base main
}

copy_shaper_setup_logs() {
  for setup_log in "$shaper_root"/*/logs/shape-setup-*.log; do
    [ -f "$setup_log" ] || continue
    cp "$setup_log" "$out_dir/$(basename "$setup_log")"
  done
}

copy_bench_setup_log() {
  [ ! -f "$setup_log_path" ] || cp "$setup_log_path" "$out_dir/task-setup.log"
}

copy_candidate_diffs() {
  [ -f "$out_dir/report.json" ] || return 0
  python3 - "$out_dir/report.json" "$out_dir" <<'PY'
import json
import os
import re
import shutil
import sys

report_path, output_dir = sys.argv[1:]
with open(report_path, encoding="utf-8") as source:
    report = json.load(source)

for candidate in report.get("candidate_diffs", []):
    if not isinstance(candidate, dict):
        continue
    filename = candidate.get("file")
    source_path = candidate.get("source_path")
    if not isinstance(filename, str) or not re.fullmatch(r"candidate(?:-[A-Za-z0-9._-]+)?\.diff", filename):
        continue
    if not isinstance(source_path, str) or not os.path.isfile(source_path):
        continue
    shutil.copyfile(source_path, os.path.join(output_dir, filename))
PY
}

write_failed_usage() {
  failed_stage=$1
  failed_model=$2
  failed_effort=$3
  failed_status=$4
  failed_wall_ms=$5
  failed_finished_ns=$(python3 -c 'import time; print(time.monotonic_ns())')
  python3 - "$out_dir/shape.json" "$out_dir/report.json" "$out_dir/usage.json" \
    "$failed_stage" "$failed_model" "$failed_effort" "$failed_status" "$failed_wall_ms" \
    "$shaper_root" "$recipe" "$timings_file" "$events_file" \
    "$bench_started_ns" "$failed_finished_ns" "$builder_model" "$builder_effort" \
    "$shape_model" "$shape_effort" "$shape_wall_ms" "$intent_source" <<'PY'
import json
import os
import sys
from pathlib import Path

(
    shape_path, report_path, output_path, failed_stage, failed_model, failed_effort,
    status, wall_ms, transcript_root, recipe, timing_input, events_output, started_ns, finished_ns,
    builder_model, builder_effort, shape_model, shape_effort, shape_wall_ms, intent_source,
) = sys.argv[1:]
provider = os.environ.get("KOGEN_BENCH_PROVIDER", "chatgpt")
egress_hosts = ["auth.x.ai", "accounts.x.ai", "grok.com", "cli-chat-proxy.grok.com"] if provider == "grok" else []
started_ns = int(started_ns)
finished_ns = int(finished_ns)
token_names = ("input", "cached_input", "output", "reasoning")

def load(path):
    try:
        with open(path, encoding="utf-8") as source:
            return json.load(source)
    except (FileNotFoundError, json.JSONDecodeError):
        return {}

def tokens(value):
    value = value or {}
    return {name: int(value.get(name, 0) or 0) for name in token_names}

def failed_shape_calls():
    transcripts = list(Path(transcript_root).glob("*/transcript.jsonl"))
    if not transcripts:
        return []
    transcript = max(transcripts, key=os.path.getmtime)
    calls = []
    try:
        with transcript.open(encoding="utf-8") as source:
            for line in source:
                row = json.loads(line)
                if row.get("event") != "model_usage" or row.get("stage") != "shape":
                    continue
                payload = row.get("payload", {})
                calls.append({
                    "model": payload.get("model"),
                    "effort": payload.get("effort"),
                    "tokens": tokens(payload.get("tokens")),
                    "wall_ms": int(payload.get("wall_ms", 0) or 0),
                    "usage_available": True,
                })
    except (OSError, json.JSONDecodeError):
        return []
    return calls

shape = load(shape_path)
report = load(report_path)
stages = []
shape_calls = [
    {
        "model": call.get("model"),
        "effort": call.get("effort"),
        "tokens": tokens(call.get("tokens")),
        "wall_ms": int(call.get("wall_ms", 0) or 0),
    }
    for call in shape.get("usage", [])
]
if not shape_calls and failed_stage == "shape":
    shape_calls = failed_shape_calls()

if shape_calls:
    stages.append({
        "stage": "shape",
        "model": shape_calls[0]["model"],
        "effort": shape_calls[0]["effort"],
        "calls": shape_calls,
        "tokens": {name: sum(call["tokens"][name] for call in shape_calls) for name in token_names},
        "wall_ms": sum(call["wall_ms"] for call in shape_calls),
        "usage_available": all(call.get("usage_available", True) for call in shape_calls),
        "usage_complete": failed_stage != "shape",
    })
elif failed_stage == "shape":
    stages.append({
        "stage": "shape",
        "model": failed_model,
        "effort": failed_effort,
        "calls": [{"tokens": tokens(None), "wall_ms": 0}],
        "tokens": tokens(None),
        "wall_ms": 0,
        "usage_available": False,
        "usage_complete": False,
        "wall_time_source": "No model usage response; elapsed time remains in the total remainder",
    })

for stage in report.get("model_stages", []):
    stage_tokens = tokens(stage.get("tokens"))
    stages.append({
        "stage": stage.get("stage"),
        "attempt": stage.get("attempt", "builder"),
        "model": stage.get("model"),
        "effort": stage.get("effort"),
        "calls": [{"tokens": stage_tokens, "wall_ms": int(stage.get("wall_ms", 0) or 0)}],
        "tokens": stage_tokens,
        "wall_ms": int(stage.get("wall_ms", 0) or 0),
        "usage_available": True,
        "partial": stage.get("partial") is True,
    })

if failed_model and failed_stage != "shape":
    stages.append({
        "stage": failed_stage,
        "model": failed_model,
        "effort": failed_effort,
        "calls": [{"tokens": tokens(None), "wall_ms": int(wall_ms)}],
        "tokens": tokens(None),
        "wall_ms": int(wall_ms),
        "usage_available": False,
        "wall_time_source": "CLI stage elapsed time; model timing is unavailable",
    })

try:
    with open(timing_input, encoding="utf-8") as source:
        event_rows = [json.loads(line) for line in source if line.strip()]
except (FileNotFoundError, json.JSONDecodeError):
    event_rows = []

for timing in report.get("phase_timings", []):
    event_rows.append({"event": "phase_timing", **timing})

phase_events = [
    row for row in event_rows
    if row.get("event") == "phase_timing"
    and isinstance(row.get("phase"), str)
    and isinstance(row.get("name"), str)
    and isinstance(row.get("wall_ms"), int)
]
phase_events.sort(key=lambda row: int(row.get("started_at", 0) or 0))
intervals = sorted(
    (int(row["started_at"]), int(row["finished_at"]))
    for row in phase_events
    if isinstance(row.get("started_at"), int)
    and isinstance(row.get("finished_at"), int)
    and row["finished_at"] >= row["started_at"]
)
union_ms = 0
if intervals:
    interval_start, interval_end = intervals[0]
    for next_start, next_end in intervals[1:]:
        if next_start <= interval_end:
            interval_end = max(interval_end, next_end)
        else:
            union_ms += interval_end - interval_start
            interval_start, interval_end = next_start, next_end
    union_ms += interval_end - interval_start

end_to_end_wall_ms = max((finished_ns - started_ns) // 1_000_000, 0)
phase_wall_ms = min(union_ms, end_to_end_wall_ms)
model_wall_ms = sum(
    int(stage.get("wall_ms", 0) or 0)
    for stage in stages
    if stage.get("usage_available") is True
)
with open(events_output, "w", encoding="utf-8") as output:
    for row in event_rows:
        if row.get("event") == "phase_timing":
            output.write(json.dumps(row, separators=(",", ":")) + "\n")

phases = [
    {"phase": row["phase"], "name": row["name"], "wall_ms": row["wall_ms"]}
    for row in phase_events
]

totals = {name: sum(stage["tokens"][name] for stage in stages) for name in token_names}
result = {
    "provider": provider,
    "egress_hosts": egress_hosts,
    "recipe": recipe,
    "edge_tests": os.environ.get("KOGEN_BENCH_EDGE_TESTS") == "1",
    "model_fallback": os.environ.get("KOGEN_BENCH_NO_FALLBACK") != "1",
    "intent_source": intent_source,
    "builder": {"model": builder_model, "effort": builder_effort},
    "run_status": "failed",
    "status": "failed",
    "landed": False,
    "best_candidate": False,
    "failed_stage": failed_stage,
    "exit_code": int(status),
    "shape": {"model": shape_model, "effort": shape_effort, "wall_ms": int(shape_wall_ms)},
    "stages": stages,
    "attempts": report.get("attempts", []),
    "candidate_diffs": [
        {
            "attempt": candidate.get("attempt"),
            "file": candidate.get("file"),
            "protected_paths_changed": candidate.get("protected_paths_changed", []),
            "red_checks": candidate.get("red_checks", []),
            "acceptance_items": candidate.get("acceptance_items", []),
        }
        for candidate in report.get("candidate_diffs", [])
        if isinstance(candidate, dict)
        and isinstance(candidate.get("file"), str)
        and os.path.isfile(os.path.join(os.path.dirname(output_path), candidate["file"]))
    ],
    "escalations": report.get("escalations", []),
    "last_gate": report.get("last_gate"),
    "stop": report.get("stop"),
    "phases": phases,
    "total": {
        "tokens": totals,
        "wall_ms": end_to_end_wall_ms,
        "model_wall_ms": model_wall_ms,
        "phase_wall_ms": phase_wall_ms,
        "unaccounted_wall_ms": max(end_to_end_wall_ms - phase_wall_ms - model_wall_ms, 0),
    },
}
with open(output_path, "w", encoding="utf-8") as output:
    json.dump(result, output, indent=2)
    output.write("\n")
PY
}

write_raw_fallback_intent() {
  if [ "$acceptance_ext" = rb ]; then
    # A provider outage uses the documented project-check-only raw mode, without a made-up smoke test.
    write_raw_intent
    return
  fi
  mkdir -p "$project_dir/.kogen/intents/$slug" "$project_dir/.kogen/acceptance"
  python3 - "$prompt_file" "$slug" "$project_dir/.kogen/intents/$slug/intent.md" \
    "$project_dir/.kogen/acceptance/${slug}_test.$acceptance_ext" <<'PY'
import sys

prompt_path, slug, intent_path, test_path = sys.argv[1:]
with open(prompt_path, encoding="utf-8") as source:
    prompt = source.read()

intent = (
    "---\n"
    "title: Raw request fallback\n"
    "domains: [app]\n"
    "size: small\n"
    "---\n"
    "Shaping stopped on a provider error, so build the task straight from the Request section "
    "below. Implement the Request. Keep the project compiling and its existing tests green.\n"
    "\n"
    "## Acceptance\n"
    "- A1: The project compiles and its smoke test passes.\n"
    "\n"
    "## Verify\n"
    "- A1: test keep\n"
    "\n"
    "## Request\n"
) + prompt

smoke_test = f"""defmodule KogenBenchRawFallbackSmokeTest do
  use ExUnit.Case, async: true

  @tag intent: "{slug}/A1"
  test "the project compiles and its Mix project loads" do
    assert is_atom(Mix.Project.config()[:app])
  end
end
"""

with open(intent_path, "w", encoding="utf-8") as target:
    target.write(intent)
with open(test_path, "w", encoding="utf-8") as target:
    target.write(smoke_test)
PY
}

write_raw_intent() {
  mkdir -p "$project_dir/.kogen/intents/$slug" "$project_dir/.kogen/acceptance"
  {
    printf '%s\n' '---' 'title: Raw request' 'domains: [app]' 'size: small' 'source: raw' '---' \
      '## Request'
    cat "$prompt_file"
  } > "$project_dir/.kogen/intents/$slug/intent.md"
  : > "$project_dir/.kogen/acceptance/${slug}_test.$acceptance_ext"
}

slug=$(basename "$task_dir")
runtime_tmpdir=$(cat "$scratch/project_tmpdir")
setup_log_path="${runtime_tmpdir%/}/$(basename "$scratch")-$slug-setup.log"
shaper_root="${runtime_tmpdir%/}/kogen-shaper/$slug"
shape_wall_ms=0
if [ "$intent_source" = provided ]; then
  mkdir -p "$project_dir/.kogen/intents/$slug" "$project_dir/.kogen/acceptance"
  cp "$provided_intent_dir/intent.md" "$project_dir/.kogen/intents/$slug/intent.md"
  cp "$provided_intent_dir/acceptance_test.$acceptance_ext" \
    "$project_dir/.kogen/acceptance/${slug}_test.$acceptance_ext"
elif [ "$intent_source" = raw ]; then
  log_line "intent source is raw: building from the verbatim prompt without shaping"
  write_raw_intent
else
  if run_capture shape "$out_dir/shape.json" "$KOGEN_BIN" intent shape "$slug" "$prompt_file" \
    --project "$project_dir" --origin "$origin" --base main; then
    shape_wall_ms=$CAPTURE_WALL_MS
    python3 - "$out_dir/shape.json" "$slug" <<'PYSHAPE'
import json
import sys
from pathlib import Path

path, slug = sys.argv[1:]
text = Path(path).read_text(encoding="utf-8")
try:
    json.loads(text)
except json.JSONDecodeError:
    calls = []
    for line in text.splitlines():
        if line.startswith("Transcript: "):
            transcript = Path(line.removeprefix("Transcript: "))
            for row in transcript.read_text(encoding="utf-8").splitlines():
                event = json.loads(row)
                if event.get("event") == "model_usage" and event.get("stage") == "shape":
                    calls.append(event["payload"])
    Path(path).write_text(json.dumps({"slug": slug, "usage": calls}), encoding="utf-8")
PYSHAPE
  else
    stage_status=$?
    shape_wall_ms=$CAPTURE_WALL_MS
    copy_shaper_setup_logs
    # Exit 4 is a provider error that survived the shaper's retries. Build from the raw prompt
    # instead of producing nothing; any other shaping failure still ends the run.
    if [ "$stage_status" -eq 4 ] && [ "$shape_fallback" = raw ]; then
      log_line "shape stopped on a provider error after its retries (exit 4); falling back to a minimal Intent whose Request is the raw prompt"
      write_raw_fallback_intent
      intent_source=raw-fallback
      rm -f "$out_dir/shape.json"
    else
      copy_bench_setup_log
      write_failed_usage shape "$shape_model" "$shape_effort" "$stage_status" "$CAPTURE_WALL_MS"
      exit "$stage_status"
    fi
  fi
fi
copy_bench_setup_log

# Approve the exact Intent bytes supplied or shaped. If shaping returned without writing one,
# let approval report the missing artifact instead of exiting before recording that failure.
intent_hash=$(python3 - "$project_dir/.kogen/intents/$slug/intent.md" <<'PY'
import hashlib
import sys

try:
    with open(sys.argv[1], "rb") as source:
        intent_bytes = source.read()
except FileNotFoundError:
    intent_bytes = b""
print(hashlib.sha256(intent_bytes).hexdigest()[:12])
PY
)
approve_ok=0
if [ "$kogen_cli_mode" = semantic ]; then
  if run_capture approve "$scratch/approve.txt" "$KOGEN_BIN" approve "$slug" "$intent_hash" \
    --project "$project_dir" --origin "$origin" --base main --by kogen-bench; then
    approve_ok=1
  else
    stage_status=$?
    if [ "$stage_status" -eq 2 ] || [ "$stage_status" -eq 90 ]; then
      if run_capture approve "$scratch/approve.txt" "$KOGEN_BIN" intent approve "$slug" "$intent_hash" \
        --project "$project_dir" --origin "$origin" --base main --by kogen-bench; then
        approve_ok=1
      else
        stage_status=$?
      fi
    fi
  fi
else
  if run_capture approve "$scratch/approve.txt" "$KOGEN_BIN" intent approve "$slug" "$intent_hash" \
    --project "$project_dir" --origin "$origin" --base main --by kogen-bench; then
    approve_ok=1
  else
    stage_status=$?
  fi
fi
if [ "$approve_ok" -eq 0 ]; then
  write_failed_usage approve "" "" "$stage_status" "$CAPTURE_WALL_MS"
  exit "$stage_status"
fi

# Approval queues the Intent; queue start builds it in the foreground and exits with its result.
build_ok=0
if [ "$kogen_cli_mode" = semantic ]; then
  if run_capture build "$scratch/build.txt" "$KOGEN_BIN" build \
    --project "$project_dir" --origin "$origin" --base main; then
    build_ok=1
  else
    stage_status=$?
    if [ "$stage_status" -eq 2 ] || [ "$stage_status" -eq 90 ]; then
      if run_capture build "$scratch/build.txt" "$KOGEN_BIN" queue start \
        --project "$project_dir" --origin "$origin" --base main; then
        build_ok=1
      else
        stage_status=$?
      fi
    fi
  fi
else
  if run_capture build "$scratch/build.txt" "$KOGEN_BIN" queue start \
    --project "$project_dir" --origin "$origin" --base main; then
    build_ok=1
  else
    stage_status=$?
  fi
fi

# A Build that did not land may still have pushed its best Candidate to kogen/<slug>; the
# benchmark grades that Candidate as the final diff.
best_candidate_branch() {
  [ -f "$out_dir/report.json" ] || return 0
  python3 - "$out_dir/report.json" <<'PY'
import json
import re
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as source:
        best = json.load(source).get("best_candidate") or {}
except (OSError, ValueError, AttributeError):
    best = {}
branch = best.get("branch") if isinstance(best, dict) else None
if isinstance(branch, str) and re.fullmatch(r"kogen/[a-z0-9]+(?:-[a-z0-9]+)*", branch):
    print(branch)
PY
}

final_ref=refs/heads/main
landed=true
if [ "$build_ok" -eq 0 ]; then
  build_wall_ms=$CAPTURE_WALL_MS
  # status recovers an interrupted (143) or crashed Build first, so the report is terminal.
  run_status_report || :
  copy_candidate_diffs
  best_branch=$(best_candidate_branch)
  if [ -n "$best_branch" ] &&
    git --git-dir="$origin" rev-parse --verify --quiet "refs/heads/$best_branch^{commit}" >/dev/null; then
    final_ref="refs/heads/$best_branch"
    landed=false
    log_line "Build did not land; grading its best candidate $best_branch"
  else
    write_failed_usage build "$builder_model" "$builder_effort" "$stage_status" "$build_wall_ms"
    exit "$stage_status"
  fi
else
  if run_status_report; then
    :
  else
    stage_status=$?
    write_failed_usage report "" "" "$stage_status" "$CAPTURE_WALL_MS"
    exit "$stage_status"
  fi
  copy_candidate_diffs
fi

git --git-dir="$origin" diff --binary "$base_sha" "$final_ref" > "$out_dir/final.diff"
git -C "$work_dir" apply --check "$out_dir/final.diff"
git -C "$work_dir" apply "$out_dir/final.diff"
[ "$(git -C "$work_dir" rev-parse HEAD)" = "$work_base" ] || {
  echo "work_dir base moved during benchmark" >&2
  exit 4
}

if [ "$landed" = true ]; then
  log_line "--- landed diff applied to work_dir ---"
else
  log_line "--- best candidate diff applied to work_dir ---"
fi
git -C "$work_dir" status --short | while IFS= read -r line; do log_line "$line"; done
log_line "work_dir base: $work_base"
if [ "$landed" = true ]; then
  log_line "Kogen landed: $(git --git-dir="$origin" rev-parse refs/heads/main)"
else
  log_line "Kogen best candidate: $final_ref $(git --git-dir="$origin" rev-parse "$final_ref")"
fi
bench_finished_ns=$(python3 -c 'import time; print(time.monotonic_ns())')

python3 - "$out_dir/shape.json" "$out_dir/report.json" "$out_dir/usage.json" \
  "$recipe" "$timings_file" "$events_file" "$bench_started_ns" "$bench_finished_ns" \
  "$builder_model" "$builder_effort" "$shape_model" "$shape_effort" "$shape_wall_ms" \
  "$slug" "$intent_source" "$landed" <<'PY'
import json
import os
import sys

shape_path, report_path, output_path, recipe, timing_input, events_output, started_ns, finished_ns, builder_model, builder_effort, shape_model, shape_effort, shape_wall_ms, slug, intent_source, landed = sys.argv[1:]
provider = os.environ.get("KOGEN_BENCH_PROVIDER", "chatgpt")
egress_hosts = ["auth.x.ai", "accounts.x.ai", "grok.com", "cli-chat-proxy.grok.com"] if provider == "grok" else []
landed = landed == "true"
started_ns = int(started_ns)
finished_ns = int(finished_ns)
shape_wall_ms = int(shape_wall_ms)
try:
    with open(shape_path, encoding="utf-8") as source:
        shape = json.load(source)
except FileNotFoundError:
    shape = {}
with open(report_path, encoding="utf-8") as source:
    report = json.load(source)

token_names = ("input", "cached_input", "output", "reasoning")

def normalized_tokens(tokens):
    tokens = tokens or {}
    return {name: int(tokens.get(name, 0) or 0) for name in token_names}

def sum_tokens(rows):
    return {name: sum(row["tokens"][name] for row in rows) for name in token_names}

shape_calls = [
    {
        "model": call["model"],
        "effort": call["effort"],
        "tokens": normalized_tokens(call.get("tokens")),
        "wall_ms": int(call.get("wall_ms", 0) or 0),
    }
    for call in shape.get("usage", [])
]

stages = []
if shape_calls:
    stages.append({
        "stage": "shape",
        "model": shape_calls[0]["model"],
        "effort": shape_calls[0]["effort"],
        "calls": shape_calls,
        "tokens": sum_tokens(shape_calls),
        "wall_ms": sum(call["wall_ms"] for call in shape_calls),
        "usage_available": True,
    })

for stage in report.get("model_stages", []):
    tokens = normalized_tokens(stage.get("tokens"))
    stages.append({
        "stage": stage.get("stage"),
        "attempt": stage.get("attempt", "builder"),
        "model": stage.get("model"),
        "effort": stage.get("effort"),
        "calls": [{"tokens": tokens, "wall_ms": int(stage.get("wall_ms", 0) or 0)}],
        "tokens": tokens,
        "wall_ms": int(stage.get("wall_ms", 0) or 0),
        "usage_available": True,
        "partial": stage.get("partial") is True,
    })

with open(timing_input, encoding="utf-8") as source:
    event_rows = [json.loads(line) for line in source if line.strip()]

for timing in report.get("phase_timings", []):
    event_rows.append({"event": "phase_timing", **timing})

phase_events = [
    row for row in event_rows
    if row.get("event") == "phase_timing"
    and isinstance(row.get("phase"), str)
    and isinstance(row.get("name"), str)
    and isinstance(row.get("wall_ms"), int)
]
phase_events.sort(key=lambda row: int(row.get("started_at", 0) or 0))

intervals = sorted(
    (int(row["started_at"]), int(row["finished_at"]))
    for row in phase_events
    if isinstance(row.get("started_at"), int)
    and isinstance(row.get("finished_at"), int)
    and row["finished_at"] >= row["started_at"]
)
union_ms = 0
if intervals:
    interval_start, interval_end = intervals[0]
    for next_start, next_end in intervals[1:]:
        if next_start <= interval_end:
            interval_end = max(interval_end, next_end)
        else:
            union_ms += interval_end - interval_start
            interval_start, interval_end = next_start, next_end
    union_ms += interval_end - interval_start

end_to_end_wall_ms = max((finished_ns - started_ns) // 1_000_000, 0)
phase_wall_ms = min(union_ms, end_to_end_wall_ms)
model_wall_ms = sum(
    int(stage.get("wall_ms", 0) or 0)
    for stage in stages
    if stage.get("usage_available") is True
)
with open(events_output, "w", encoding="utf-8") as output:
    for row in event_rows:
        if row.get("event") == "phase_timing":
            output.write(json.dumps(row, separators=(",", ":")) + "\n")

phases = [
    {"phase": row["phase"], "name": row["name"], "wall_ms": row["wall_ms"]}
    for row in phase_events
]

totals = {name: sum(stage["tokens"][name] for stage in stages) for name in token_names}
result = {
    "provider": provider,
    "egress_hosts": egress_hosts,
    "recipe": recipe,
    "edge_tests": os.environ.get("KOGEN_BENCH_EDGE_TESTS") == "1",
    "model_fallback": os.environ.get("KOGEN_BENCH_NO_FALLBACK") != "1",
    "edge_probe": report.get("edge_probe"),
    "intent_source": intent_source,
    "slug": shape.get("slug") or slug,
    "run_status": "complete",
    "status": report.get("status"),
    "landed": landed,
    "best_candidate": not landed,
    "best_candidate_detail": None if landed else report.get("best_candidate"),
    "roles": report.get("roles", {}),
    "builder": {"model": builder_model, "effort": builder_effort},
    "shape": {"model": shape_model, "effort": shape_effort, "wall_ms": shape_wall_ms},
    "attempts": report.get("attempts", []),
    "candidate_diffs": [
        {
            "attempt": candidate.get("attempt"),
            "file": candidate.get("file"),
            "protected_paths_changed": candidate.get("protected_paths_changed", []),
            "red_checks": candidate.get("red_checks", []),
            "acceptance_items": candidate.get("acceptance_items", []),
        }
        for candidate in report.get("candidate_diffs", [])
        if isinstance(candidate, dict)
        and isinstance(candidate.get("file"), str)
        and os.path.isfile(os.path.join(os.path.dirname(output_path), candidate["file"]))
    ],
    "escalations": report.get("escalations", []),
    "last_gate": report.get("last_gate"),
    "stop": report.get("stop"),
    "stages": stages,
    "phases": phases,
    "total": {
        "tokens": totals,
        "wall_ms": end_to_end_wall_ms,
        "model_wall_ms": model_wall_ms,
        "phase_wall_ms": phase_wall_ms,
        "unaccounted_wall_ms": max(end_to_end_wall_ms - phase_wall_ms - model_wall_ms, 0),
    },
}
with open(output_path, "w", encoding="utf-8") as output:
    json.dump(result, output, indent=2)
    output.write("\n")
PY

printf 'benchmark complete\nwork_dir: %s\nusage: %s\nlog: %s\ndiff: %s\n' \
  "$work_dir" "$out_dir/usage.json" "$log_file" "$out_dir/final.diff"
